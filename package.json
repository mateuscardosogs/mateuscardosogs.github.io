{
  "name": "mateuscardosogs.github.io",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Personal site and CV of Mateus Cardoso — built on the MCode design system.",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && npm run build:server && npm run prerender",
    "build:client": "vite build --outDir dist",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir .ssr",
    "prerender": "node scripts/prerender.mjs",
    "cv:pdf": "node scripts/make-cv-pdf.mjs",
    "preview": "vite preview --outDir dist",
    "serve": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "images": "node scripts/make-images.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
